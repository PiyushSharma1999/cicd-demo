pipeline {
    agent any

    environment {
        IMAGE_NAME = 'trialqqfbzu.jfrog.io/test-cicd-demo/cicd-demo'
        ARTIFACTORY_URL = 'https://trialqqfbzu.jfrog.io/artifactory/test-cicd-demo/'
        SONAR_HOST = 'http://sonarqube:9000'
        APP_VERSION = "${GIT_COMMIT[0..7]}"
        IMAGE_TAG = "${IMAGE_NAME}:${APP_VERSION}"
    }

    triggers {
        githubPush() // Github webhook, action: push
    }

    stages {
        stage('Base image validation') {
            steps {
                sh './scripts/base-image-validate.sh python:3.12-slim'
            }
        }

        stage('Wiz dockerfile scan') {
            steps {
                sh './scripts/wiz-scan.sh dockerfile Dockerfile'
            }
        }

        stage('Docker build') {
            steps {
                sh """
                    docker build \
                        --label 'git.commit=${GIT_COMMIT}' \
                        --label 'build.number=${BUILD_NUMBER}' \
                        -t ${IMAGE_TAG} .
                """
            }
        }

        stage('Wiz image scan') {
            steps {
                sh "./scripts/wiz-scan.sh image ${IMAGE_TAG}"
            }
        }

        stage('Cosign sign') {
            steps {
                withCredentials([string(credentialsId: 'COSIGN_KEY', variable: 'COSIGN_KEY')]) {
                    sh "./scripts/cosign-sign.sh ${IMAGE_TAG}"
                }
            }
        }

        stage('Push to Artifactory') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'ARTIFACTORY_CREDS',
                    usernameVariable: 'ART_USER',
                    passwordVariable: 'ART_PASS'
                )]) {
                    sh """
                        docker login ${ARTIFACTORY_URL} -u ${ART_USER} -p ${ART_PASS}
                        docker push ${IMAGE_TAG}
                        docker tag ${IMAGE_TAG} ${IMAGE_NAME}:latest
                        docker push ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                          -Dsonar.projectKey=cicd-demo \
                          -Dsonar.sources=app \
                          -Dsonar.python.version=3.12
                    """
                }
                timeout(time:5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Integration tests') {
            steps {
                sh """
                    sleep 5 # wait for container to be ready
                    APP_URL=http://localhost:5001 \
                      python -m pytest app/tests/test_integration.py -v
                """
            }
        }

        stage('Gate: approve or rollback') {
            steps {
                script {
                    def result = input(
                        message: "Deploy ${APP_VERSION} to staging?",
                        ok: 'Approve',
                        parameters: [
                            choice(name: 'ACTION', choices: ['Deploy', 'Rollback'], description: '')
                        ]
                    )
                    if (result=='Rollback') {
                        sh "docker stop cicd-demo-dev || true"
                        error("Rollback triggered by user")
                    }
                }
            }
        }
    }

    post {
        success { echo "Pipeline succeeded: ${IMAGE_TAG}" }
        failure {
            sh "docker stop cicd-demo-dev || true"
            echo "Pipeline failed - dev env cleaned up"
        }
    }
}